.git/**
.gitignore
tsconfig.json
esbuild.js
eslint.config.js
.prettierrc.json
.prettierignore
.editorconfig
CLAUDE.md

# Dependencies (bundled by esbuild)
node_modules/**

# Maps (not needed in production)
**/*.map

# Misc
**/.DS_Store
*.vsix
